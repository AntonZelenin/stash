# Copy to terraform.tfvars (gitignored) and adjust. No secrets belong here.

project     = "stash"
environment = "prod"
aws_region  = "eu-central-1"

# aws_profile = "stash"

# extra_tags = {
#   Owner = "platform"
# }

# vpc_cidr = "10.0.0.0/16"

# db_instance_class    = "db.t4g.micro"
# db_allocated_storage = 20

# Extra web frontend origins (e.g. a local dx serve against this API), without
# a trailing slash. The CloudFront frontend is always allowed.
# s3_cors_allowed_origins = ["http://localhost:8080"]

# Per-queue worker settings. Lambda timeout = worker_timeout_seconds (one
# message) x worker_batch_size; visibility = Lambda timeout x multiplier.
# worker_timeout_seconds = {
#   document_analysis_jobs = 300
# }
# worker_batch_size = {
#   embedding_jobs = 1
# }
# worker_max_concurrency = { # the cap on each worker's instances
#   thumbnail_jobs = 5
#   content_analysis_jobs = 3
# }
# sqs_visibility_timeout_multiplier = 3
# max_delivery_attempts             = 5 # keep equal to MAX_DELIVERY_ATTEMPTS

# Permissions boundary of every Lambda execution role, from ../github_oidc
# (output lambda_permissions_boundary_arn). CI always sets it; set it here too
# so a local apply doesn't remove it.
# lambda_permissions_boundary_arn = "arn:aws:iam::123456789012:policy/stash-prod-lambda-boundary"

# Lambda packages: python scripts/build_lambda_packages.py (build/lambda/*.zip).
# No function reserves concurrency by default; a reservation needs an account
# concurrency quota of at least 100 + all reservations.
# lambda_config = {
#   api        = { memory_size = 1024, reserved_concurrency = 20 }
#   migrations = { timeout = 600 }
# }
# api_cors_allowed_origins = ["http://localhost:8080"] # extra; CloudFront is always allowed

# Observability. Alarms notify the alarm_topic_arn SNS topic; confirm the
# email subscription from the message AWS sends.
# alarm_email = "ops@example.com"
# alarm_thresholds = {
#   worker_errors = 3 # thumbnailer / document_analyzer, per 5 minutes
#   api_5xx       = 5
# }
# lambda_log_retention_days = 14
