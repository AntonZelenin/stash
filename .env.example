# Copy this file to .env and adjust as needed for local development.

# PostgreSQL
POSTGRES_USER=stash
POSTGRES_PASSWORD=stash
POSTGRES_DB=stash
POSTGRES_PORT=5432

# Valkey
VALKEY_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=stash

# API
API_PORT=8000

# Frontend
FRONTEND_PORT=8080
