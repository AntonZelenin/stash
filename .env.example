# Copy this file to .env and adjust as needed for local development.

# PostgreSQL
POSTGRES_USER=stash
POSTGRES_PASSWORD=stash
POSTGRES_DB=stash
POSTGRES_PORT=5432

# Valkey
VALKEY_PORT=6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=stash

# API
API_PORT=8000

# Frontend
FRONTEND_PORT=8080

# Content analyzer (image descriptions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Embeddings for semantic search (API + embedding worker must match)
EMBEDDING_MODEL=text-embedding-3-small

# Logging (all backend services).
# PLATFORM = where it runs; picks the log format: local = readable lines,
# aws = AWS Lambda Powertools (needs stash-shared[aws]), anything else
# (e.g. digitalocean) = one JSON object per line.
PLATFORM=local
# ENVIRONMENT = deployment stage (local, dev, stage, prod); only labels logs.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Tracing (all backend services; see stash_shared.tracing). Spans are sent
# over OTLP/HTTP to Jaeger (UI at http://localhost:${JAEGER_UI_PORT}).
# Set TRACING_OTLP_ENDPOINT to send them to another OTLP/HTTP collector.
TRACING_ENABLED=true
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318

# Metrics (all backend services; see stash_shared.metrics) are published to
# CloudWatch only when PLATFORM=aws (needs stash-shared[aws]), under this
# namespace; everywhere else they're a no-op.
# METRICS_NAMESPACE=Stash
