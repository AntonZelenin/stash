# Copy this file to .env and adjust as needed for local development.

# PostgreSQL
POSTGRES_USER=stash
POSTGRES_PASSWORD=stash
POSTGRES_DB=stash
POSTGRES_PORT=5432

# Valkey
VALKEY_PORT=6379

# Queue backend: picked from PLATFORM (aws = SQS, anything else = Valkey);
# QUEUE_PROVIDER=valkey|sqs overrides it. On SQS, each queue's URL:
# SQS_QUEUE_URLS={"thumbnail_jobs": "https://sqs.<region>.amazonaws.com/<account>/<queue>", ...}

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=stash

# API
API_PORT=8000

# Frontend
FRONTEND_PORT=8080

# Content analyzer (image descriptions)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Embeddings for semantic search (API + embedding worker must match)
EMBEDDING_MODEL=text-embedding-3-small
# Rewrites search queries into English before embedding them (API only)
SEARCH_QUERY_NORMALIZATION_MODEL=gpt-5-nano

# Rate limits and quotas (API only; see docs/architecture.md, "Rate limits
# and quotas"). On by default with production values; false turns them all
# off, e.g. while load testing locally. Each limit can also be set on its
# own, e.g. LOGIN_LIMIT_PER_IP=100/1m or SEARCH_LIMIT_PER_USER=600/1m.
RATE_LIMITS_ENABLED=true

# Cloudflare Turnstile on registration (API: app.turnstile). Locally,
# Cloudflare's test keys: this secret accepts the tokens of the test site
# key the frontend's debug build uses, every time (the widget says it's for
# testing), but verifying still needs internet access. To register offline,
# turn it off in both: TURNSTILE_ENABLED=false and STASH_TURNSTILE_SITE_KEY=
# (empty: the frontend shows no widget; takes a frontend rebuild).
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# STASH_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Document analyzer processing limits (how much of an upload is read and
# parsed; see document_analyzer.config). The values shown are the
# production defaults, which apply when a setting is left unset: compose
# passes these on only when set. Lower them to try the limits on small
# files.
# DOCUMENT_MAX_PREFIX_BYTES=8388608
# DOCUMENT_MAX_BYTES_READ=67108864
# DOCUMENT_MAX_DOWNLOAD_BYTES=536870912
# DOCUMENT_MAX_UNCOMPRESSED_BYTES=67108864
# DOCUMENT_MAX_PDF_PAGES=50
# DOCUMENT_MAX_ARCHIVE_ENTRIES=10000
# DOCUMENT_MAX_MEMBER_BYTES=67108864
# DOCUMENT_MAX_COMPRESSION_RATIO=200
# DOCUMENT_MAX_XML_ELEMENTS=2000000
# DOCUMENT_MAX_PDF_PAGE_COUNT=10000
# DOCUMENT_MAX_PDF_OPEN_BYTES=8388608
# DOCUMENT_MAX_PDF_PAGE_CONTENT_BYTES=2097152
# DOCUMENT_MAX_PDF_STREAM_BYTES=16777216
# DOCUMENT_MAX_TEXT_CHARS=240000
# DOCUMENT_PARSE_TIMEOUT_SECONDS=60

# Thumbnailer processing limits (see thumbnailer.config), checked from an
# image's header before decoding it. Same as above: unset = the default.
# THUMBNAIL_MAX_WIDTH=50000
# THUMBNAIL_MAX_HEIGHT=50000
# THUMBNAIL_MAX_DECLARED_PIXELS=250000000
# THUMBNAIL_MAX_PIXELS=50000000
# THUMBNAIL_MAX_SOURCE_BYTES=104857600

# Logging (all backend services).
# PLATFORM = where it runs; picks the log format: local = readable lines,
# aws = AWS Lambda Powertools (needs stash-shared[aws]), anything else
# (e.g. digitalocean) = one JSON object per line.
PLATFORM=local
# ENVIRONMENT = deployment stage (local, dev, stage, prod); only labels logs.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Tracing (all backend services; see stash_shared.tracing). Spans are sent
# over OTLP/HTTP to Jaeger (UI at http://localhost:${JAEGER_UI_PORT}).
# Set TRACING_OTLP_ENDPOINT to send them to another OTLP/HTTP collector.
TRACING_ENABLED=true
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318

# Metrics (all backend services; see stash_shared.metrics) are published to
# CloudWatch only when PLATFORM=aws (needs stash-shared[aws]), under this
# namespace; everywhere else they're a no-op.
# METRICS_NAMESPACE=Stash
